#!/usr/bin/env python3
"""sacct simulado para las pruebas.

Lee los trabajos de un escenario en JSON (variable SACCT_ESCENARIO) y responde
como `sacct -n -P` con los campos de -o, filtrando por --name o -j. Los pasos
(JobID con punto) siguen el nombre de su trabajo, como en el sacct real.
Si SACCT_LOG está definida, anota ahí cada llamada; con SACCT_CODIGO termina
con ese código de error.
"""

import json
import os
import sys

args = sys.argv[1:]
if os.environ.get("SACCT_LOG"):
    with open(os.environ["SACCT_LOG"], "a") as f:
        f.write(json.dumps(args) + "\n")
if os.environ.get("SACCT_CODIGO"):
    sys.exit(int(os.environ["SACCT_CODIGO"]))

with open(os.environ["SACCT_ESCENARIO"]) as f:
    filas = json.load(f)

campos, nombres, jobid = [], None, None
i = 0
while i < len(args):
    a = args[i]
    if a == "-o":
        campos = args[i + 1].split(",")
        i += 1
    elif a == "-j":
        jobid = args[i + 1]
        i += 1
    elif a.startswith("--name="):
        nombres = a.split("=", 1)[1].split(",")
    elif a in ("-u", "-S", "-E"):
        i += 1
    i += 1

nombre_de = {f["JobID"]: f["JobName"] for f in filas if "." not in f["JobID"]}
for f in filas:
    principal = f["JobID"].split(".")[0]
    if jobid is not None and principal != jobid:
        continue
    if nombres is not None and nombre_de.get(principal) not in nombres:
        continue
    print("|".join(f.get(c, "") for c in campos))
