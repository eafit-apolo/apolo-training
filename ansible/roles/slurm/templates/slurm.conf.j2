# {{ ansible_managed }}
ClusterName={{ slurm_cluster_name }}
SlurmctldHost={{ slurm_node_name }}
MpiDefault=none
ProctrackType=proctrack/cgroup
ReturnToService=1
SlurmctldPidFile=/var/run/slurmctld.pid
SlurmctldPort=6817
SlurmdPidFile=/var/run/slurmd.pid
SlurmdPort=6818
SlurmdSpoolDir=/var/spool/slurmd
SlurmUser=slurm
StateSaveLocation=/var/spool/slurmctld
SwitchType=switch/none
TaskPlugin=task/cgroup,task/affinity
InactiveLimit=0
KillWait=30
MinJobAge=300
SlurmctldTimeout=120
SlurmdTimeout=300
Waittime=0
DefMemPerCPU={{ slurm_def_mem_per_cpu }}
SchedulerType=sched/backfill
SelectType=select/cons_tres
SelectTypeParameters=CR_Core_Memory
AccountingStorageHost=localhost
AccountingStorageType=accounting_storage/slurmdbd
JobAcctGatherFrequency=30
JobAcctGatherType=jobacct_gather/cgroup
SlurmctldDebug=info
SlurmctldLogFile=/var/log/slurm/slurmctld.log
SlurmdDebug=info
SlurmdLogFile=/var/log/slurm/slurmd.log
NodeName={{ slurm_node_name }} CPUs=4 Boards=1 SocketsPerBoard=1 CoresPerSocket=4 ThreadsPerCore=1 RealMemory={{ slurm_node_realmemory }} State=UNKNOWN
PartitionName={{ slurm_particion }} Nodes={{ slurm_node_name }} Default=YES DefaultTime={{ slurm_particion_default_time }} MaxTime={{ slurm_particion_max_time }} State=UP
PropagateResourceLimitsExcept=MEMLOCK
JobCompType=jobcomp/filetxt
SlurmctldParameters=enable_configless
LaunchParameters=use_interactive_step
