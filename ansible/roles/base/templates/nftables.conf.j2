#!/usr/sbin/nft -f
# {{ ansible_managed }}

table inet apolo_training
delete table inet apolo_training

table inet apolo_training {
	set ssh_permitido    { type ipv4_addr; flags interval; elements = { {{ base_ssh_permitido | join(', ') }} } }
	set salida_bloqueada { type ipv4_addr; flags interval; elements = { {{ base_salida_bloqueada | join(', ') }} } }
	set dns              { type ipv4_addr; flags interval; elements = { {{ base_dns_servidores | join(', ') }} } }
	set ntp              { type ipv4_addr; flags interval; elements = { {{ base_ntp_servidores | join(', ') }} } }
	set https_interno    { type ipv4_addr; flags interval; elements = { {{ base_salida_https | join(', ') }} } }

	chain entrada {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } accept
		# F1
		ip saddr @ssh_permitido tcp dport 22 accept
		ip saddr @ssh_permitido icmp type echo-request accept
		# F2
		reject with icmpx admin-prohibited
	}

	chain salida {
		type filter hook output priority filter; policy drop;
		ct state established,related accept
		oif "lo" accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit } accept
		# F3, F4, F5
		ip daddr @salida_bloqueada reject with icmpx admin-prohibited
		# S1
		ip daddr @dns meta l4proto { tcp, udp } th dport 53 accept
		# S2
		ip daddr @ntp udp dport 123 accept
		# Sincronización de laboratorios con la 117
		ip daddr @https_interno tcp dport 443 accept
{% if base_internet_hasta %}
		# S4
		meta time <= "{{ base_internet_hasta }} 23:59:59" tcp dport { 80, 443 } accept
{% endif %}
		# D
		reject with icmpx admin-prohibited
	}

	chain reenvio {
		type filter hook forward priority filter; policy drop;
	}
}
